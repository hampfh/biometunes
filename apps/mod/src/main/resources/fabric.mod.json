{
  "schemaVersion": 1,
  "id": "biometunes",
  "version": "${version}",
  "name": "BiomeTunes",
  "description": "Crossfading biome soundtracks for Minecraft.",
  "authors": ["Hampus Hallkvist"],
  "contact": {
    "sources": "https://github.com/BiomeTunes/datapack",
    "issues": "https://github.com/BiomeTunes/datapack/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/biometunes/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.hampushallkvist.biometunes.client.BiomeTunesClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "com.hampushallkvist.biometunes.ui.BiomeTunesModMenu"
      }
    ]
  },
  "mixins": ["biometunes.client.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  }
}
